generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("visitor") // "merchant" | "visitor"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant       Merchant?
  ratings        Rating[]
  favorites      Favorite[]
  follows        MerchantFollow[]
  reports        Report[]
  notifications  Notification[]
  pushTokens     PushToken[]
  files          File[]

  @@index([role])
}

model Merchant {
  id             String    @id @default(uuid())
  userId         String    @unique
  shopName       String?
  tradeType      String?   // clothing, food, electronics, furniture, jewelry, household, toys, other
  governorateId  String?
  delegationId   String?
  phone          String?
  logoFileId     String?
  setupComplete  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  governorate Governorate? @relation(fields: [governorateId], references: [id])
  delegation  Delegation?  @relation(fields: [delegationId], references: [id])
  logoFile    File?        @relation(fields: [logoFileId], references: [id])
  products    Product[]
  ratings     Rating[]
  follows     MerchantFollow[]
  reports     Report[]
  notifications Notification[]

  @@index([governorateId])
  @@index([delegationId])
  @@index([tradeType])
  @@index([setupComplete])
}

model File {
  id                String   @id @default(uuid())
  userId            String
  fileName          String
  cloud_storage_path String  @unique
  isPublic          Boolean  @default(false)
  contentType       String
  fileSize          Int?
  createdAt         DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantLogos  Merchant[]
  productImages  ProductImage[]

  @@index([userId])
}

model Governorate {
  id        String   @id @default(uuid())
  name      String   @unique
  nameAr    String
  nameFr    String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  delegations  Delegation[]
  merchants    Merchant[]
  visitorStats VisitorStat[]
}

model Delegation {
  id             String   @id @default(uuid())
  governorateId  String
  name           String
  nameAr         String
  nameFr         String
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())

  governorate  Governorate   @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  merchants    Merchant[]
  visitorStats VisitorStat[]

  @@unique([governorateId, name])
  @@index([governorateId])
}

model Product {
  id          String   @id @default(uuid())
  merchantId  String
  name        String
  price       Float
  phone       String
  description String?
  expiryDate  DateTime
  publishDate DateTime @default(now())
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant  Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  images    ProductImage[]
  favorites Favorite[]
  notifications Notification[]

  @@index([merchantId])
  @@index([publishDate])
  @@index([expiryDate])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  fileId    String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId])
}

model Rating {
  id         String   @id @default(uuid())
  userId     String
  merchantId String
  score      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model MerchantFollow {
  id         String   @id @default(uuid())
  userId     String
  merchantId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([userId])
  @@index([merchantId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String   @default("new_product")
  message    String
  productId  String?
  merchantId String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Report {
  id         String   @id @default(uuid())
  userId     String
  merchantId String
  reason     String   // counterfeit, fraud, inappropriate, other
  details    String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([userId])
}

model VisitorStat {
  id             String    @id @default(uuid())
  governorateId  String?
  delegationId   String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime  @default(now())

  governorate Governorate? @relation(fields: [governorateId], references: [id])
  delegation  Delegation?  @relation(fields: [delegationId], references: [id])

  @@index([governorateId])
  @@index([delegationId])
  @@index([createdAt])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  deviceType String   // ios, android
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
